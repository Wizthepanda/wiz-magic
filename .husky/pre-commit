#!/usr/bin/env sh

# 🔒 Security: Scan for secrets before committing
echo "🔍 Scanning for secrets and API keys..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Patterns to detect (common secret patterns)
PATTERNS=(
  "AIzaSy[0-9A-Za-z_-]{33}"              # Google API Keys
  "AKIA[0-9A-Z]{16}"                      # AWS Access Key
  "[0-9a-f]{32}"                          # Generic 32-char hex (MD5)
  "sk-[0-9A-Za-z]{48}"                    # OpenAI API Keys
  "xox[baprs]-[0-9]{10,12}-[0-9]{10,12}"  # Slack tokens
  "ghp_[0-9A-Za-z]{36}"                   # GitHub Personal Access Token
  "gho_[0-9A-Za-z]{36}"                   # GitHub OAuth Token
  "firebase.*['\"]apiKey['\"]:\s*['\"][^'\"]+['\"]"  # Firebase config objects
)

# Files to check (staged files) - INCLUDING HTML FILES
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|env|yml|yaml|config|html|htm)$' || true)

if [ -z "$FILES" ]; then
  echo "${GREEN}✅ No relevant files to scan${NC}"
  exit 0
fi

echo "📄 Scanning files:"
echo "$FILES" | sed 's/^/  - /'
echo ""

FOUND_SECRETS=0

for FILE in $FILES; do
  # Skip .env files (they're already in .gitignore)
  if [[ "$FILE" == *".env"* ]]; then
    echo "${YELLOW}⚠️  Warning: Attempting to commit .env file: $FILE${NC}"
    echo "   This file should be in .gitignore!"
    FOUND_SECRETS=1
    continue
  fi

  # Check each pattern
  for PATTERN in "${PATTERNS[@]}"; do
    if git show ":$FILE" | grep -qE "$PATTERN"; then
      echo "${RED}❌ BLOCKED: Potential secret detected in $FILE${NC}"
      echo "   Pattern: $PATTERN"
      echo ""
      FOUND_SECRETS=1
    fi
  done

  # Check for hardcoded Firebase config objects
  if git show ":$FILE" | grep -qE "apiKey.*:.*['\"][A-Za-z0-9_-]{30,}['\"]"; then
    echo "${RED}❌ BLOCKED: Hardcoded Firebase API key detected in $FILE${NC}"
    echo "   Use environment variables instead: process.env.VITE_FIREBASE_API_KEY"
    echo ""
    FOUND_SECRETS=1
  fi
done

if [ $FOUND_SECRETS -eq 1 ]; then
  echo "${RED}═══════════════════════════════════════════════════════${NC}"
  echo "${RED}🚨 COMMIT BLOCKED: Secrets detected!${NC}"
  echo "${RED}═══════════════════════════════════════════════════════${NC}"
  echo ""
  echo "How to fix:"
  echo "  1. Remove hardcoded secrets from the files above"
  echo "  2. Use environment variables instead:"
  echo "     ${GREEN}const apiKey = process.env.VITE_FIREBASE_API_KEY;${NC}"
  echo "  3. Add secrets to .env file (already in .gitignore)"
  echo "  4. Create .env.example with template values"
  echo ""
  echo "If you're ABSOLUTELY SURE this is a false positive:"
  echo "  git commit --no-verify -m 'your message'"
  echo ""
  exit 1
fi

echo "${GREEN}✅ No secrets detected - commit allowed${NC}"
echo ""
exit 0
