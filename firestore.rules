rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users and their subcollections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && validateUserUpdate(request.resource.data, resource != null ? resource.data : {});
      
      // User video progress tracking - users can read/write only their own data
      match /videos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Completed videos - can only create, not modify XP awards
      match /completedVideos/{videoId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
      
      // Level up logs - read-only after creation
      match /levelUps/{logId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
      
      // Badges - read-only for users, system creates them
      match /badges/{badgeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    
    // User tracking data - alternative path structure
    match /userTracking/{userId}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User tracking data main collection
    match /userTrackingData/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public read access for leaderboard and content
    match /leaderboard/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Video content - public read, authenticated write
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Creator videos - creators can manage their own videos
    match /creatorVideos/{videoId} {
      allow read: if true; // Public read for discovery
      allow write: if request.auth != null; // Any authenticated user can write
    }
    
    // Creator profiles and tokens - users can only access their own
    match /creators/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Creator profiles - public read for discovery features, authenticated write
    match /creatorProfiles/{userId} {
      allow read: if true; // Public read for discovery
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Creator stats - public read for leaderboards, creator can write their own
    match /creatorStats/{userId} {
      allow read: if true; // Public read for leaderboards
      allow write: if request.auth != null; // System or creator can write
    }
    
    // YouTube subscriptions tracking
    match /youtubeSubscriptions/{subscriptionId} {
      allow read, write: if request.auth != null;
    }
    
    // Anti-cheat watch sessions - users can read their own sessions only
    // Only Cloud Functions can write to prevent tampering
    match /watchSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // Only Cloud Functions can write
    }

    // Course collections for Learn tab (free and paid courses)
    match /courses_learn/{courseId} {
      allow read: if true; // Public read for course discovery
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Course collections for Claim tab (XP-based courses)
    match /courses_claim/{courseId} {
      allow read: if true; // Public read for course discovery
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Draft courses collection
    match /courses_drafts/{courseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.creatorId;
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Course enrollments - users can manage their own enrollments
    match /courseEnrollments/{enrollmentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Course progress tracking
    match /courseProgress/{userId}/courses/{courseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

// Validation function to ensure XP updates are reasonable
function validateUserUpdate(newData, existingData) {
  // Allow YouTube profile updates without XP validation
  return ('youtubeProfile' in newData) || 
         ('youtubeConnected' in newData) || 
         ('youtubeSubscriptions' in newData) ||
         ('displayName' in newData) || 
         ('photoURL' in newData) ||
         // For XP-related updates, validate reasonably
         (('currentXP' in newData || 'totalXP' in newData || 'dailyXpEarned' in newData) ? 
           validateXPUpdate(newData, existingData) : true);
}

// Helper function for XP validation
function validateXPUpdate(newData, existingData) {
  let currentXP = 'currentXP' in existingData ? existingData.currentXP : 0;
  let newXP = 'currentXP' in newData ? newData.currentXP : currentXP;
  let currentDailyXP = 'dailyXpEarned' in existingData ? existingData.dailyXpEarned : 0;
  let newDailyXP = 'dailyXpEarned' in newData ? newData.dailyXpEarned : currentDailyXP;

  // Allow reasonable XP increases (max 500 XP per update, max 360 daily XP)
  return (newXP >= currentXP) &&
         (newXP - currentXP <= 500) &&
         (newDailyXP <= 360) &&
         (newDailyXP >= 0);
}

// Validation function for course data
function validateCourseData(courseData) {
  // Ensure required fields are present and valid
  return 'title' in courseData && courseData.title is string && courseData.title.size() > 0 &&
         'description' in courseData && courseData.description is string &&
         'category' in courseData && courseData.category is string &&
         'creatorId' in courseData && courseData.creatorId is string &&
         'creatorName' in courseData && courseData.creatorName is string &&
         'accessType' in courseData && courseData.accessType in ['free', 'xp', 'xp-copay', 'paid'] &&
         'status' in courseData && courseData.status in ['draft', 'published'] &&
         'publishedTo' in courseData && courseData.publishedTo in ['learn', 'claim'] &&
         // Validate XP requirements
         ('xpRequired' in courseData ? courseData.xpRequired is number && courseData.xpRequired >= 0 : true) &&
         // Validate price
         ('price' in courseData ? courseData.price is number && courseData.price >= 0 : true) &&
         // Validate modules structure
         ('modules' in courseData ? courseData.modules is list : true);
}