rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users and their subcollections
    match /users/{userId} {
      // Allow public read for profile viewing (usernames, avatars, bios, etc.)
      // But write only your own data
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && validateUserUpdate(request.resource.data, resource != null ? resource.data : {});
      
      // User video progress tracking - users can read/write only their own data
      match /videos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Completed videos - can only create, not modify XP awards
      match /completedVideos/{videoId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
      
      // Level up logs - read-only after creation
      match /levelUps/{logId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
      
      // Badges - read-only for users, system creates them
      match /badges/{badgeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    
    // User tracking data - alternative path structure
    match /userTracking/{userId}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User tracking data main collection
    match /userTrackingData/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ZAPs system - users can read their own ZAP data, Cloud Functions can write
    match /userZAPs/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ZAPs daily logs - users can read their own logs, system can write
    match /zapDailyLogs/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily ZAPs tracking - users can read/write their own daily logs
    match /dailyZAPs/{logId} {
      allow read, write: if request.auth != null &&
        logId.matches(request.auth.uid + '_.*'); // logId format: userId_date
    }
    
    // Public read access for leaderboard and content
    match /leaderboard/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Video content - public read, authenticated write
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Creator videos - creators can manage their own videos
    match /creatorVideos/{videoId} {
      allow read: if true; // Public read for discovery
      allow write: if request.auth != null; // Any authenticated user can write
    }
    
    // Discover collection - for published YouTube videos
    match /discover/{videoId} {
      allow read: if true; // Public read for discovery feed
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.creatorId &&
                    validateDiscoverVideo(request.resource.data);
      allow update: if request.auth != null &&
                    request.auth.uid == resource.data.creatorId;
      allow delete: if request.auth != null &&
                    request.auth.uid == resource.data.creatorId;
    }
    
    // Creator profiles and tokens - users can only access their own
    match /creators/{creatorId} {
      allow read: if true; // Public read for creator discovery
      allow write: if request.auth != null && request.auth.uid == creatorId;
    }
    
    // Featured creators collection - public read for homepage
    match /featuredCreators/{docId} {
      allow read: if true; // Public read for homepage featured section
      allow write: if false; // Only admins via console
    }
    
    // Creator profiles - public read for discovery features, authenticated write
    match /creatorProfiles/{userId} {
      allow read: if true; // Public read for discovery
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Creator stats - public read for leaderboards, creator can write their own
    match /creatorStats/{userId} {
      allow read: if true; // Public read for leaderboards
      allow write: if request.auth != null; // System or creator can write
    }
    
    // YouTube subscriptions tracking
    match /youtubeSubscriptions/{subscriptionId} {
      allow read, write: if request.auth != null;
    }

    // Followers collection - users can follow/unfollow
    match /followers/{followId} {
      allow read: if true; // Public read for follower counts and lists
      allow create: if request.auth != null &&
                    request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null &&
                    resource.data.followerId == request.auth.uid;
      allow update: if false; // Followers are immutable after creation
    }
    
    // Anti-cheat watch sessions - users can read their own sessions only
    // Only Cloud Functions can write to prevent tampering
    match /watchSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // Only Cloud Functions can write
    }

    // Course collections for Community tab (free and paid courses)
    match /courses_community/{courseId} {
      allow read: if true; // Public read for course discovery
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Course collections for Claim tab (XP-based courses)
    match /courses_claim/{courseId} {
      allow read: if true; // Public read for course discovery
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Draft courses collection
    match /courses_drafts/{courseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.creatorId;
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCourseData(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Course enrollments - users can manage their own enrollments
    match /courseEnrollments/{enrollmentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Course progress tracking
    match /courseProgress/{userId}/courses/{courseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Communities collection - for community creation and management
    match /communities/{communityId} {
      allow read: if true; // Public read for community discovery
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.creatorId &&
                   validateCommunityDataForStatus(request.resource.data);
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.creatorId &&
                   validateCommunityDataForStatus(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;

      // Community members subcollection - users can join/leave
      match /members/{userId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Community posts - authenticated members can post, everyone can read
      match /posts/{postId} {
        allow read: if true; // Public read for all posts
        allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.authorId;
        // Allow updates for:
        // 1. Author/creator for all fields
        // 2. Any authenticated user for voting/reaction fields only
        allow update: if request.auth != null && (
                       // Post author or community creator can update anything
                       (request.auth.uid == resource.data.authorId ||
                        request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId) ||
                       // Any authenticated user can update voting/reaction counts
                       (isVotingUpdate(request.resource.data, resource.data))
                     );
        allow delete: if request.auth != null && (
                       request.auth.uid == resource.data.authorId ||
                       request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId
                     );

        // Post votes subcollection - users can vote on posts
        match /votes/{userId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == userId;
        }

        // Post reactions subcollection - users can react to posts
        match /userReactions/{userId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == userId;
        }

        // Post replies subcollection - authenticated users can reply
        match /replies/{replyId} {
          allow read: if true; // Public read for all replies
          allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.authorId;
          // Allow updates for:
          // 1. Author/creator for all fields
          // 2. Any authenticated user for voting fields only
          allow update: if request.auth != null && (
                         // Reply author or community creator can update anything
                         (request.auth.uid == resource.data.authorId ||
                          request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId) ||
                         // Any authenticated user can update voting counts
                         (isReplyVotingUpdate(request.resource.data, resource.data))
                       );
          allow delete: if request.auth != null && (
                         request.auth.uid == resource.data.authorId ||
                         request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId
                       );

          // Reply votes subcollection - users can vote on replies
          match /votes/{userId} {
            allow read: if request.auth != null;
            allow write: if request.auth != null && request.auth.uid == userId;
          }
        }
      }
    }

    // Transactions collection - for ZAP transfers and purchases
    // Cloud Functions handle writes, users can only read their own
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
                  resource.data.userId == request.auth.uid ||
                  resource.data.senderId == request.auth.uid ||
                  resource.data.recipientId == request.auth.uid
                );
      allow create, write: if request.auth != null && (
                    request.resource.data.userId == request.auth.uid ||
                    request.resource.data.senderId == request.auth.uid
                   );
      allow delete: if false; // Transactions are immutable
    }

    // Messaging system - chats and messages collections
    match /chats/{chatId} {
      // Users can read chats they are a participant in
      allow read: if request.auth != null &&
                  request.auth.uid in resource.data.participants;
      // Users can create chats where they are a participant
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.participants;
      // Users can update chats they are a participant in (for typing status, last message, etc.)
      allow update: if request.auth != null &&
                    request.auth.uid in resource.data.participants;
      allow delete: if false; // Chats should not be deleted

      // Messages subcollection
      match /messages/{messageId} {
        // Users can read messages in chats they are a participant in
        allow read: if request.auth != null &&
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Users can create messages in chats they are a participant in
        allow create: if request.auth != null &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      request.auth.uid == request.resource.data.senderId;
        // Users can update messages they sent (for emoji reactions, read status)
        allow update: if request.auth != null &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if false; // Messages should not be deleted
      }
    }

    // Typing status collection (for real-time typing indicators)
    match /typingStatus/{chatId}/users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

// Validation function to ensure XP updates are reasonable
function validateUserUpdate(newData, existingData) {
  // Allow profile updates without XP validation
  return ('youtubeProfile' in newData) || 
         ('youtubeConnected' in newData) || 
         ('youtubeSubscriptions' in newData) ||
         ('displayName' in newData) || 
         ('photoURL' in newData) ||
         ('username' in newData) ||
         ('bio' in newData) ||
         ('updatedAt' in newData) ||
         // For XP-related updates, validate reasonably
         (('currentXP' in newData || 'totalXP' in newData || 'dailyXpEarned' in newData) ? 
           validateXPUpdate(newData, existingData) : true);
}

// Helper function for XP validation
function validateXPUpdate(newData, existingData) {
  let currentXP = 'currentXP' in existingData ? existingData.currentXP : 0;
  let newXP = 'currentXP' in newData ? newData.currentXP : currentXP;
  let currentDailyXP = 'dailyXpEarned' in existingData ? existingData.dailyXpEarned : 0;
  let newDailyXP = 'dailyXpEarned' in newData ? newData.dailyXpEarned : currentDailyXP;

  // Allow reasonable XP increases (max 500 XP per update, max 360 daily XP)
  return (newXP >= currentXP) &&
         (newXP - currentXP <= 500) &&
         (newDailyXP <= 360) &&
         (newDailyXP >= 0);
}

// Validation function for course data
function validateCourseData(courseData) {
  // Ensure required fields are present and valid
  return 'title' in courseData && courseData.title is string && courseData.title.size() > 0 &&
         'description' in courseData && courseData.description is string &&
         'category' in courseData && courseData.category is string &&
         'creatorId' in courseData && courseData.creatorId is string &&
         'creatorName' in courseData && courseData.creatorName is string &&
         // Accept either old accessType or new pricingModel for backwards compatibility
         (('accessType' in courseData && courseData.accessType in ['free', 'xp', 'xp-copay', 'paid']) ||
          ('pricingModel' in courseData && courseData.pricingModel in ['free', 'free-zaps', 'usd', 'zaps', 'zaps-usd', 'crypto'])) &&
         'status' in courseData && courseData.status in ['draft', 'published'] &&
         'publishedTo' in courseData && courseData.publishedTo in ['community', 'claim'] &&
         // Validate XP/ZAPs requirements (legacy xpRequired or new zapsRequired)
         ('xpRequired' in courseData ? courseData.xpRequired is number && courseData.xpRequired >= 0 : true) &&
         ('zapsRequired' in courseData ? courseData.zapsRequired is number && courseData.zapsRequired >= 0 : true) &&
         // Validate price/USD fields
         ('price' in courseData ? courseData.price is number && courseData.price >= 0 : true) &&
         ('usdCoPay' in courseData ? courseData.usdCoPay is number && courseData.usdCoPay >= 0 : true) &&
         // Validate modules structure
         ('modules' in courseData ? courseData.modules is list : true) &&
         // Validate crypto types (optional array)
         ('cryptoTypes' in courseData ? courseData.cryptoTypes is list : true) &&
         // Validate trial fields
         ('trialEnabled' in courseData ? courseData.trialEnabled is bool : true) &&
         ('trialDuration' in courseData ? courseData.trialDuration is number && courseData.trialDuration > 0 : true) &&
         ('trialUnit' in courseData ? courseData.trialUnit in ['days', 'weeks'] : true) &&
         // Validate duplicate prevention fields
         ('contentHash' in courseData ? courseData.contentHash is string : true) &&
         ('youtubeVideoIds' in courseData ? courseData.youtubeVideoIds is list : true) &&
         ('sourceType' in courseData ? courseData.sourceType in ['youtube', 'manual', 'hybrid'] : true) &&
         ('version' in courseData ? courseData.version is number && courseData.version > 0 : true) &&
         ('isLatestVersion' in courseData ? courseData.isLatestVersion is bool : true) &&
         ('zapRewardAwarded' in courseData ? courseData.zapRewardAwarded is bool : true) &&
         ('originalCourseId' in courseData ? courseData.originalCourseId is string : true) &&
         ('previousVersionId' in courseData ? courseData.previousVersionId is string : true);
}

// Validation function for community data based on status
function validateCommunityDataForStatus(communityData) {
  // For drafts, only require creatorId and status (allow partial data)
  return ('status' in communityData && communityData.status == 'draft') ?
    validateDraftCommunity(communityData) : validatePublishedCommunity(communityData);
}

// Validation for draft communities (lenient - allows partial data)
function validateDraftCommunity(communityData) {
  return 'creatorId' in communityData && communityData.creatorId is string &&
         'status' in communityData && communityData.status == 'draft' &&
         // Optional fields - validate if present
         ('title' in communityData ? (communityData.title is string && communityData.title.size() >= 0) : true) &&
         ('category' in communityData ? communityData.category is string : true) &&
         ('shortDescription' in communityData ? communityData.shortDescription is string : true) &&
         ('privacy' in communityData ? communityData.privacy in ['public', 'private', 'invite'] : true) &&
         ('pricingModel' in communityData ? communityData.pricingModel in ['free', 'free-zaps', 'usd', 'zaps', 'zaps-usd', 'crypto', 'waitlist'] : true) &&
         ('zapsRequired' in communityData ? (communityData.zapsRequired is number && communityData.zapsRequired >= 0) : true) &&
         ('usdCoPay' in communityData ? (communityData.usdCoPay is number && communityData.usdCoPay >= 0) : true) &&
         // Allow all other fields that Creator Studio 2.0 uses
         ('tagline' in communityData ? communityData.tagline is string : true) &&
         ('profileIcon' in communityData ? communityData.profileIcon is string : true) &&
         ('coverMedia' in communityData ? communityData.coverMedia is list : true) &&
         ('longDescription' in communityData ? communityData.longDescription is string : true) &&
         ('tags' in communityData ? communityData.tags is list : true) &&
         ('creatorName' in communityData ? communityData.creatorName is string : true) &&
         ('creatorPhoto' in communityData ? communityData.creatorPhoto is string : true) &&
         ('zapRewardTiers' in communityData ? communityData.zapRewardTiers is list : true) &&
         ('linkedCourseId' in communityData ? communityData.linkedCourseId is string : true) &&
         ('waitlistEnabled' in communityData ? communityData.waitlistEnabled is bool : true) &&
         ('freeTrialEnabled' in communityData ? communityData.freeTrialEnabled is bool : true) &&
         ('freeTrialDays' in communityData ? communityData.freeTrialDays is number : true) &&
         ('cryptoTypes' in communityData ? communityData.cryptoTypes is list : true) &&
         ('cryptoAmount' in communityData ? communityData.cryptoAmount is string : true) &&
         ('linkedCourseName' in communityData ? communityData.linkedCourseName is string : true) &&
         ('accessWindow' in communityData ? communityData.accessWindow is string : true) &&
         ('memberCount' in communityData ? communityData.memberCount is number : true) &&
         ('membersCount' in communityData ? communityData.membersCount is number : true) &&
         ('creatorAvatar' in communityData ? communityData.creatorAvatar is string : true) &&
         ('publishDate' in communityData ? true : true) &&
         // Allow timestamp fields that are automatically added
         ('createdAt' in communityData ? true : true) &&
         ('updatedAt' in communityData ? true : true) &&
         ('publishedAt' in communityData ? true : true);
}

// Validation for published/scheduled communities (strict - requires all fields)
function validatePublishedCommunity(communityData) {
  return 'creatorId' in communityData && communityData.creatorId is string &&
         'status' in communityData && communityData.status in ['published', 'scheduled', 'live'] &&
         'title' in communityData && communityData.title is string && communityData.title.size() >= 5 &&
         'category' in communityData && communityData.category is string &&
         'shortDescription' in communityData && communityData.shortDescription is string &&
         'privacy' in communityData && communityData.privacy in ['public', 'private', 'invite'] &&
         // Allow all pricingModel types including waitlist
         ('pricingModel' in communityData ? communityData.pricingModel in ['free', 'free-zaps', 'usd', 'zaps', 'zaps-usd', 'crypto', 'waitlist'] : true) &&
         ('zapsRequired' in communityData ? (communityData.zapsRequired is number && communityData.zapsRequired >= 0) : true) &&
         ('usdCoPay' in communityData ? (communityData.usdCoPay is number && communityData.usdCoPay >= 0) : true) &&
         // Allow optional fields used by Creator Studio 2.0
         ('tagline' in communityData ? communityData.tagline is string : true) &&
         ('profileIcon' in communityData ? communityData.profileIcon is string : true) &&
         ('coverMedia' in communityData ? communityData.coverMedia is list : true) &&
         ('longDescription' in communityData ? communityData.longDescription is string : true) &&
         ('tags' in communityData ? communityData.tags is list : true) &&
         ('creatorName' in communityData ? communityData.creatorName is string : true) &&
         ('creatorPhoto' in communityData ? communityData.creatorPhoto is string : true) &&
         ('creatorAvatar' in communityData ? communityData.creatorAvatar is string : true) &&
         ('memberCount' in communityData ? communityData.memberCount is number : true) &&
         ('membersCount' in communityData ? communityData.membersCount is number : true) &&
         ('publishDate' in communityData ? true : true) &&
         ('zapRewardTiers' in communityData ? communityData.zapRewardTiers is list : true) &&
         ('linkedCourseId' in communityData ? communityData.linkedCourseId is string : true) &&
         ('linkedCourseName' in communityData ? communityData.linkedCourseName is string : true) &&
         ('waitlistEnabled' in communityData ? communityData.waitlistEnabled is bool : true) &&
         ('accessWindow' in communityData ? communityData.accessWindow is string : true) &&
         ('freeTrialEnabled' in communityData ? communityData.freeTrialEnabled is bool : true) &&
         ('freeTrialDays' in communityData ? communityData.freeTrialDays is number : true) &&
         ('cryptoTypes' in communityData ? communityData.cryptoTypes is list : true) &&
         ('cryptoAmount' in communityData ? communityData.cryptoAmount is string : true) &&
         // Allow timestamp fields that are automatically added
         ('createdAt' in communityData ? true : true) &&
         ('updatedAt' in communityData ? true : true) &&
         ('publishedAt' in communityData ? true : true);
}

// Legacy validation function - kept for backwards compatibility but not used
function validateCommunityData(communityData) {
  return validateCommunityDataForStatus(communityData);
}

// Validation function for community member updates (joining communities)
function validateCommunityMemberUpdate(newData, existingData) {
  // When using arrayUnion and serverTimestamp, only memberCount appears in newData.keys()
  // The members and lastUpdated are handled as transforms
  // So we just check if memberCount is being updated and increases by 1
  return 'memberCount' in newData &&
         newData.memberCount == existingData.memberCount + 1;
}

// Helper function to check if update is only modifying voting/reaction fields
function isVotingUpdate(newData, existingData) {
  // Get the keys that are different between new and existing data
  let changedKeys = newData.diff(existingData).affectedKeys();

  // Only allow changes to voting/reaction fields
  return changedKeys.hasOnly(['upvotes', 'downvotes', 'reactions', 'commentCount', 'updatedAt']);
}

// Helper function to check if reply update is only modifying voting fields
function isReplyVotingUpdate(newData, existingData) {
  // Get the keys that are different between new and existing data
  let changedKeys = newData.diff(existingData).affectedKeys();

  // Only allow changes to voting fields for replies
  return changedKeys.hasOnly(['upvotes', 'downvotes', 'updatedAt']);
}

// Validation function for discover videos
function validateDiscoverVideo(videoData) {
  return 'creatorId' in videoData && videoData.creatorId is string &&
         'videoId' in videoData && videoData.videoId is string &&
         'title' in videoData && videoData.title is string && videoData.title.size() > 0 &&
         'thumbnail' in videoData && videoData.thumbnail is string &&
         'category' in videoData && videoData.category is string &&
         'subcategory' in videoData && videoData.subcategory is string &&
         'type' in videoData && videoData.type == 'youtube_video' &&
         'status' in videoData && videoData.status == 'published' &&
         'visibility' in videoData && videoData.visibility in ['public', 'private', 'waitlist'];
}