rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to upload to community-covers directory
    match /community-covers/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // Max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Allow authenticated users to upload to profile-pictures directory
    match /profile-pictures/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Allow authenticated users to upload to communities directory (icons and cover media)
    match /communities/{communityId}/{subfolder}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // Max 10MB
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType == '' ||  // Allow empty content type as fallback
                     fileName.matches('.*\\.(jpg|jpeg|png|webp|gif|bmp|svg|tiff|tif|ico|heic|heif)$')
                   );
    }

    // Allow authenticated users to upload community post images
    match /community_posts/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId  // Users can only upload to their own folder
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
