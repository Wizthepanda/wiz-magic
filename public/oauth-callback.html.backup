<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTube Connection - WIZ</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      color: white;
    }

    .container {
      text-align: center;
      padding: 40px;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      max-width: 400px;
    }

    .spinner {
      border: 4px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top: 4px solid white;
      width: 48px;
      height: 48px;
      animation: spin 1s linear infinite;
      margin: 0 auto 24px;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    h2 {
      margin: 0 0 12px;
      font-size: 24px;
      font-weight: 600;
    }

    p {
      margin: 0;
      font-size: 14px;
      opacity: 0.9;
    }

    .error {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.5);
    }

    .success {
      background: rgba(34, 197, 94, 0.2);
      border: 1px solid rgba(34, 197, 94, 0.5);
    }
  </style>
</head>
<body>
  <div class="container" id="status">
    <div class="spinner"></div>
    <h2>Connecting YouTube...</h2>
    <p>Please wait while we complete the connection.</p>
  </div>

  <script>
    /**
     * YouTube OAuth Callback Handler
     *
     * This page is the redirect URI for Google OAuth.
     * It exchanges the authorization code for tokens via the backend,
     * then sends the result back to the main window via postMessage.
     */
    (async function() {
      const statusEl = document.getElementById('status');

      try {
        console.log('🔄 OAuth callback page loaded');

        // Extract OAuth parameters from URL
        const params = new URLSearchParams(window.location.search);
        const code = params.get('code');
        const state = params.get('state');
        const error = params.get('error');
        const errorDescription = params.get('error_description');

        // Check for OAuth errors
        if (error) {
          throw new Error(errorDescription || error || 'OAuth error occurred');
        }

        if (!code) {
          throw new Error('No authorization code received');
        }

        console.log('📋 Authorization code received, exchanging for tokens...');

        // Exchange code for tokens via backend (Firebase Cloud Function)
        const response = await fetch('https://us-central1-wiz-magic-platform.cloudfunctions.net/exchangeYouTubeCode', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            code,
            state
          }),
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({ error: 'Exchange failed' }));
          throw new Error(errorData.error || `HTTP ${response.status}: ${response.statusText}`);
        }

        const result = await response.json();

        console.log('✅ Token exchange successful:', result);

        // Update UI to show success
        statusEl.className = 'container success';
        statusEl.innerHTML = `
          <div style="font-size: 48px; margin-bottom: 16px;">✓</div>
          <h2>Connected Successfully!</h2>
          <p>Returning to WIZ...</p>
        `;

        // Prepare message payload
        const payload = {
          type: 'YOUTUBE_CONNECTED',
          success: true,
          channelId: result.channelId,
          channelTitle: result.channelTitle,
          channelAvatar: result.channelAvatar,
          subscriberCount: result.subscriberCount,
        };

        // Send message to opener window
        if (window.opener && !window.opener.closed) {
          console.log('📤 Sending success message to main window');
          window.opener.postMessage(payload, window.location.origin);
        } else {
          console.warn('⚠️ Opener window not available');
        }

        // Close popup after short delay
        setTimeout(() => {
          console.log('🚪 Closing popup');
          window.close();
        }, 1000);

      } catch (err) {
        console.error('❌ OAuth callback error:', err);

        // Update UI to show error
        statusEl.className = 'container error';
        statusEl.innerHTML = `
          <div style="font-size: 48px; margin-bottom: 16px;">✕</div>
          <h2>Connection Failed</h2>
          <p>${err.message || 'An error occurred'}</p>
        `;

        // Send error message to opener
        if (window.opener && !window.opener.closed) {
          console.log('📤 Sending error message to main window');
          window.opener.postMessage({
            type: 'YOUTUBE_CONNECTED',
            success: false,
            error: err.message || 'Connection failed',
          }, window.location.origin);
        }

        // Close popup after delay
        setTimeout(() => {
          window.close();
        }, 3000);
      }
    })();
  </script>
</body>
</html>
